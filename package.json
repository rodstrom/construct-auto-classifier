{
  "name": "construct-auto-classifier",
  "version": "0.4.0",
  "private": true,
  "description": "Effect-based safety gate for AI coding agents (Antigravity, OpenCode, Pi): deterministic rules, then TypeSafe's Jev or any chat model judges what a shell command or file edit does, not what it is called.",
  "license": "Apache-2.0",
  "author": "godspede",
  "repository": {
    "type": "git",
    "url": "https://github.com/godspede/construct-auto-classifier.git"
  },
  "homepage": "https://github.com/godspede/construct-auto-classifier#readme",
  "bugs": {
    "url": "https://github.com/godspede/construct-auto-classifier/issues"
  },
  "engines": {
    "node": ">=18",
    "bun": ">=1.2"
  },
  "dependencies": {
    "jiti": "^2.7.0"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "auto-classifier": "./bin/auto-classifier.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./opencode": {
      "types": "./dist/adapters/opencode.d.ts",
      "default": "./dist/opencode-plugin.js"
    },
    "./opencode-plugin": {
      "types": "./dist/adapters/opencode.d.ts",
      "default": "./dist/opencode-plugin.js"
    },
    "./pi": "./dist/pi/pi-plugin.js"
  },
  "scripts": {
    "build": "bun build ./src/cli.ts --outfile ./dist/cli.js --target node && bun build ./src/adapters/opencode.ts --outfile ./dist/opencode-plugin.js --target node && bun build ./src/adapters/pi.ts --outfile ./dist/pi/pi-plugin.js --target node --external @gotgenes/pi-permission-system --external jiti && bun build ./src/index.ts --outfile ./dist/index.js --target node && tsc --emitDeclarationOnly -p .",
    "build:binary": "bun build --compile --minify ./src/cli.ts --outfile ./dist/auto-classifier",
    "prepare": "bun run build",
    "test": "bun test",
    "typecheck": "tsc --noEmit -p ."
  },
  "pi": {
    "extensions": ["./dist/pi/pi-plugin.js"]
  },
  "keywords": [
    "ai",
    "ai-safety",
    "coding-agents",
    "guardrails",
    "safety",
    "security",
    "shell",
    "command-classification",
    "llm",
    "pi-package",
    "classifier",
    "opencode",
    "antigravity",
    "agy",
    "jev",
    "typesafe"
  ],
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.4.0"
  }
}
